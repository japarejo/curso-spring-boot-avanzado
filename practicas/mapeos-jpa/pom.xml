<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        ====================================================================
        Laboratorio de mapeos JPA (modulo 6, ejercicio 8).

        Una entidad (o pareja de entidades) por cada diapositiva de mapeo del
        temario, con pruebas @DataJpaTest que las ejercitan y el DDL generado
        volcado a target/ddl-generado.sql para leerlo con calma.

        Proyecto independiente, con su propio Maven embebido. Desde esta carpeta:
            ./mvnw test          (Linux / macOS)
            .\mvnw test          (Windows)
        ====================================================================
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.idexaformacion.cursos</groupId>
    <artifactId>mapeos-jpa</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mapeos-jpa</name>
    <description>Laboratorio de mapeos JPA del modulo 6</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
