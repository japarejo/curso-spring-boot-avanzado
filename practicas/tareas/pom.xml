<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        ====================================================================
        Practica "tareas": la aplicacion que se crea DESDE CERO en el modulo 1
        (ejercicio 6) y que se reutiliza en los modulos 3 y 6.

        Es la solucion de referencia de lo que genera Spring Initializr, con
        la version de Spring Boot fijada a 3.5.16, la misma que el resto del
        curso (Initializr ya solo ofrece versiones con soporte abierto).

        NO forma parte del reactor del curso, a proposito: es un proyecto
        independiente, como el que el alumno genera, y por eso lleva su propio
        Maven embebido (mvnw, mvnw.cmd y .mvn/wrapper). No hace falta tener
        Maven instalado. Desde esta carpeta:
            ./mvnw spring-boot:run          (Linux / macOS)
            .\mvnw spring-boot:run          (Windows)
        ====================================================================
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.idexaformacion.cursos</groupId>
    <artifactId>tareas</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>tareas</name>
    <description>Aplicacion creada desde cero con Spring Initializr (modulo 1)</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- API REST: Spring MVC + Jackson + Tomcat embebido -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Bean Validation (@NotBlank, @Size...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Persistencia: Spring Data JPA + Hibernate. El starter NO elige base
             de datos: hay que anadir el driver aparte (diapositiva 31). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Documentacion interactiva: http://localhost:8080/swagger-ui.html
             Se usa en clase en lugar de curl para probar la API. No la gestiona el
             BOM de Spring Boot, asi que lleva version (la misma que el resto del curso). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.9.1</version>
        </dependency>
        <!-- Monitorizacion: /actuator/** -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            MODULO 3, ejercicio 8: descomentar para ver la seguridad POR DEFECTO
            de Spring Boot (contrasena generada, pagina de login, Basic).
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        -->

        <!-- Reinicio automatico al recompilar. Solo en desarrollo: el plugin de
             Spring Boot lo excluye del artefacto final. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Pruebas: JUnit 5, AssertJ, Mockito, Hamcrest, Spring Test, JsonPath -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
