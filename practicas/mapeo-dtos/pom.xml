<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        ====================================================================
        Mapeo entidad <-> DTO con MapStruct (ampliacion del modulo 2).

        En petclinic-api los DTOs se rellenan a mano (OwnerResponse.from()).
        Aqui se hace lo mismo con MapStruct, que GENERA ese codigo al compilar.
        Se ve en target/generated-sources/annotations/.

        Proyecto independiente, con su propio Maven embebido. Desde esta carpeta:
            ./mvnw test          (Linux / macOS)
            .\mvnw test          (Windows)
        ====================================================================
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.idexaformacion.cursos</groupId>
    <artifactId>mapeo-dtos</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mapeo-dtos</name>
    <description>Mapeo entidad-DTO con MapStruct</description>

    <properties>
        <java.version>21</java.version>
        <!-- Spring Boot NO gestiona la version de MapStruct: hay que fijarla. -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.version>1.18.44</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Solo las anotaciones (@Mapper, @Mapping...). El generador va abajo,
             en annotationProcessorPaths: no hace falta en tiempo de ejecucion. -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        Los procesadores de anotaciones que corren al compilar. Dos trampas:

                        1. En cuanto se declara annotationProcessorPaths, Maven deja de
                           buscar procesadores en las dependencias. Si aqui solo aparece
                           MapStruct, Lombok no se ejecuta y no hay getters ni setters.

                        2. MapStruct necesita los getters que genera Lombok. Con
                           lombok-mapstruct-binding, MapStruct espera a Lombok sea cual
                           sea el orden. Sin el, depende del orden de esta lista: con
                           MapStruct delante falla con "Type Propietario has no properties".

                        Si el proyecto no usa Lombok, solo hace falta mapstruct-processor.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
