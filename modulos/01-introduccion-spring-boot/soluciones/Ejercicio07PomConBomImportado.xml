<?xml version="1.0" encoding="UTF-8"?>
<!--
    =============================================================================
    Modulo 1 - Ejercicio 7: importar el BOM en lugar de heredar del parent.

    SOLUCION DE REFERENCIA para practicas/tareas/pom.xml.

    Con <parent>spring-boot-starter-parent</parent> se heredan DOS cosas:
      1. dependencyManagement  -> las versiones de ~400 librerias (el BOM)
      2. pluginManagement y propiedades -> configuracion de plugins, encoding,
         java.version, -parameters, filtrado de recursos con @...@, etc.

    Importando spring-boot-dependencies solo se obtiene la 1. Lo que sigue
    restituye a mano lo imprescindible de la 2. Cada bloque marcado con
    "LO QUE DABA EL PARENT" es algo que el alumno debe descubrir que falta.
    =============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Aqui podria ir el parent CORPORATIVO de la empresa: Maven solo admite uno.
         Ese es precisamente el caso de uso de importar el BOM. -->

    <groupId>com.idexaformacion.cursos</groupId>
    <artifactId>tareas</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <properties>
        <spring-boot.version>3.5.16</spring-boot.version>
        <!-- LO QUE DABA EL PARENT: version de Java y codificacion -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Exactamente las mismas que con el parent, y sin version: el BOM sigue
             gestionandolas. Esa parte NO se pierde. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- LO QUE DABA EL PARENT: -parameters. Sin el, @PathVariable Integer id
                 (sin nombre explicito) falla en tiempo de ejecucion con
                 "Name for argument of type [java.lang.Integer] not specified". -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>

            <!-- LO QUE DABA EL PARENT: version del plugin y la ejecucion `repackage`.
                 Sin ella, `mvn package` produce un jar normal, NO ejecutable:
                 java -jar falla con "no main manifest attribute". -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
