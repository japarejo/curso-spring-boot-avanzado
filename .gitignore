# --- Build ---
target/
build/

# Binarios: no se versionan. Tampoco el maven-wrapper.jar: mvnw y mvnw.cmd
# lo descargan solos la primera vez (wrapperUrl en .mvn/wrapper/maven-wrapper.properties).
# Si se versionan los scripts mvnw, mvnw.cmd y maven-wrapper.properties, para
# que clonar el repo y ejecutar ./mvnw funcione sin Maven instalado.
*.jar
*.war

# --- Logs ---
*.log
log.txt
logs/

# --- Eclipse / STS ---
.classpath
.project
.settings/
.factorypath
bin/

# --- IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr
out/

# --- VS Code ---
# Se ignora todo salvo los ficheros compartidos del curso, para que el
# editor se comporte igual en todas las maquinas desde el primer arranque.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# --- NetBeans ---
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Secretos: NUNCA se versionan (modulo 3) ---
